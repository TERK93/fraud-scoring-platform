# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Kaggle API credentials, used by ingestion/kaggle_loader.py to download the
# full "Credit Card Fraud Detection" dataset (mlg-ulb/creditcardfraud) for
# model training: `kaggle datasets download -d mlg-ulb/creditcardfraud`
# Get these from https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# PostgreSQL connection used by the ingestion and API services.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frauddb

# FastAPI service config
API_HOST=0.0.0.0
API_PORT=8000
